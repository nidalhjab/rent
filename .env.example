# --- Database (Neon) ---------------------------------------------------------
# Pooled endpoint (hostname contains `-pooler`) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct endpoint used by `prisma migrate` / `prisma db push`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Admin dashboard ---------------------------------------------------------
ADMIN_USERNAME="admin"
# scrypt hash, generated with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH="scrypt:...:..."
# Session signing key: openssl rand -base64 32
AUTH_SECRET=""

# --- Cloudinary (image storage) ---------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google Gemini (AI try-on) ----------------------------------------------
GEMINI_API_KEY=""

# --- Public site URL ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://rent-jade-sigma.vercel.app"

# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=""
